  "cards": [
    {
      "dot": "cyan",
      "title": "What the model decides",
      "items": [
        "Whether a DOB clerk's comment closed a violation, quoting the words that decided it",
        "How to word the renewal, from the job description an architect filed",
        "Which single question is worth interrupting a contractor for"
      ]
    },
    {
      "dot": "rose",
      "title": "What it can never decide",
      "items": [
        "Whether a permit is inside the 30 day action window",
        "Whether a later sequence already superseded it",
        "Whether anything may be filed at all"
      ]
    },
    {
      "dot": "emerald",
      "title": "What is true when nobody is watching",
      "items": [
        "HOLD is most of the output, and every HOLD is an alarm correctly not sent",
        "A case id is a hash of contractor, kind and DOB identifier, so a rerun is the same case",
        "A deadline this program cannot cite is one it refuses to compute"
      ]
    }
  ]
